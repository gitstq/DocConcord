# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# Build & distribution artifacts
build/
dist/
*.egg-info/
.eggs/
*.whl
*.tar.gz

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local configuration that must never be committed
.env
.env.local
*.local.json

# Generated reports (keep them out of the tree by default)
docconcord-report.*
docconcord.xml
